{
  "name": "CPU WIMS — Warehouse Inventory Management System",
  "short_name": "CPU WIMS",
  "description": "Central Philippine University Warehouse Inventory Management System — real-time warehouse inventory with cost tracking, variance analysis, fast movers, low-stock alerts and salvage recommendations.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#10218b",
  "theme_color": "#10218b",
  "categories": ["business", "productivity"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Stock In", "short_name": "Stock In", "url": "./#/receive", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Stock Out", "short_name": "Stock Out", "url": "./#/issue", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "New Requisition", "short_name": "Request", "url": "./#/catalog", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Alerts", "short_name": "Alerts", "url": "./#/alerts", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ],
  "screenshots": [
    { "src": "screenshots/desktop.png", "sizes": "1440x900", "type": "image/png", "form_factor": "wide", "label": "Live dashboard" },
    { "src": "screenshots/mobile.png", "sizes": "780x1688", "type": "image/png", "form_factor": "narrow", "label": "Mobile dashboard" }
  ]
}
